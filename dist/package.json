{
  "name": "evp-design-ui",
  "version": "0.1.0-beta.0",
  "description": "evp-design-ui is a lightweight and easy-custom UI framework with atomlized attributes for React.js.",
  "main": "index.js",
  "module": "esm/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./esm/index.js",
      "require": "./index.js"
    },
    "./*": "./*"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "browser": {
    "crypto": false
  },
  "dependencies": {
    "@types/react-syntax-highlighter": "^15.5.7",
    "bezier-easing": "^2.1.0",
    "classnames": "^2.3.2",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "nanoid": "^3.3.11",
    "react-calendar": "^4.6.0",
    "react-syntax-highlighter": "^15.5.0",
    "tslib": "^2.6.1"
  }
}
